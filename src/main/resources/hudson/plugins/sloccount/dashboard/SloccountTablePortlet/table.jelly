<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:t="/lib/hudson">

  <st:adjunct includes="hudson.plugins.sloccount.SloccountResult.style"/>
        <thead>
            <tr>
                <th>${%Job}</th>
                <th align="right">${%Lines}</th>
                <th align="right">${%Comments}</th>
                <th align="right">${%Files}</th>
                <th align="right">${%Languages}</th>
            </tr>
        </thead>
        <tbody>
            <j:forEach var="job" items="${jobs}">
                <tr>
                    <j:set var="stats" value="${it.getStatistics(job)}" />

                    <td><div class="dbv-cell"><t:buildHealth td="false"/><t:jobLink job="${job}"/></div></td>
                    <td class="number" data="${stats.lineCount}">${stats.lineCountString}</td>
                    <td class="number" data="${stats.commentCount}">${stats.commentCountString}</td>
                    <td class="number" data="${stats.fileCount}">${stats.fileCountString}</td>
                    <td class="number" data="${stats.languageCount}">${stats.languageCountString}</td>

                    <j:set var="totalLines" value="${totalLines + stats.lineCount}"/>
                    <j:set var="totalFiles" value="${totalFiles + stats.fileCount}"/>
                </tr>
            </j:forEach>
        </tbody>
        <tfoot>
            <tr class="sortbottom">
                <th class="slc-left">${%Total}</th>
                <th class="number" data="${totalLines}">${it.grouping(totalLines)}</th>
                <th class="number" data="${totalComments}">${it.grouping(totalComments)}</th>
                <th class="number" data="${totalFiles}">${it.grouping(totalFiles)}</th>
                <th class="number" data="0">-</th>
            </tr>
        </tfoot>
</j:jelly>
